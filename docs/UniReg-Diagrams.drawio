  <!-- ═══════════════════════════════════════════════
       PAGE 4 — STATE MACHINE DIAGRAM (BONUS)
       ═══════════════════════════════════════════════ -->
  <diagram id="statemachine" name="4 - State Machine Diagram">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="State Machine Diagram — Enrollment Lifecycle" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="1054" height="40" as="geometry" />
        </mxCell>

        <!-- Initial -->
        <mxCell id="init" value="" style="ellipse;aspect=fixed;fillColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="817" y="80" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- PENDING -->

        <!-- ENROLLED -->
        <mxCell id="stEnrolled" value="ENROLLED&#xa;[confirmed seat]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="730" y="350" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- WAITLISTED -->
        <mxCell id="stWaitlisted" value="WAITLISTED&#xa;[in queue]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1100" y="350" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- DROPPED -->
        <mxCell id="stDropped" value="DROPPED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="580" width="160" height="55" as="geometry" />
        </mxCell>

        <!-- COMPLETED -->
        <mxCell id="stCompleted" value="COMPLETED&#xa;[credit counted]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="730" y="580" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- CANCELLED -->

        <!-- Final -->
        <mxCell id="final" value="" style="ellipse;aspect=fixed;fillColor=#000000;strokeColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="817" y="730" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="finalring" value="" style="ellipse;aspect=fixed;fillColor=none;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="810" y="723" width="44" height="44" as="geometry" />
        </mxCell>

        <!-- ── TRANSITIONS ── -->
        <!-- init → PENDING -->
        <mxCell id="t0" value="submit() [all checks pass]" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="init" target="stEnrolled" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- PENDING → ENROLLED [all checks pass] -->

        <!-- PENDING → WAITLISTED [section full] -->
        <mxCell id="t2" value="submit() [section full]" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="init" target="stWaitlisted" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="830" y="120" />
              <mxPoint x="1200" y="190" />
              <mxPoint x="1200" y="350" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- WAITLISTED → ENROLLED [seat frees, re-val passes] -->
        <mxCell id="t3" value="seat_frees() [re-validation passes]" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="stWaitlisted" target="stEnrolled" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1200" y="380" />
              <mxPoint x="1200" y="280" />
              <mxPoint x="830" y="280" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- WAITLISTED → DROPPED [student drops waitlist] -->
        <mxCell id="t4" value="student_drops_waitlist()" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="stWaitlisted" target="stDropped" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1100" y="400" />
              <mxPoint x="900" y="400" />
              <mxPoint x="900" y="560" />
              <mxPoint x="520" y="560" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ENROLLED → DROPPED [drop() within window] -->
        <mxCell id="t5" value="drop() [within drop window]" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="stEnrolled" target="stDropped" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="730" y="380" />
              <mxPoint x="520" y="380" />
              <mxPoint x="520" y="580" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ENROLLED → COMPLETED [term_ends()] -->
        <mxCell id="t6" value="term_ends()" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="stEnrolled" target="stCompleted" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ENROLLED → CANCELLED [admin_cancel()] -->

        <!-- WAITLISTED → CANCELLED [admin_cancel()] -->

        <!-- Terminal states → Final -->
        <mxCell id="t9" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" source="stDropped" target="final" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="520" y="720" />
              <mxPoint x="832" y="720" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="t10" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" source="stCompleted" target="final" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- AuditLog note -->
        <mxCell id="note" value="Core demo states: ENROLLED, WAITLISTED, DROPPED, COMPLETED.&#xa;PENDING and CANCELLED remain reserved in the schema but are not shown here." style="text;html=1;strokeColor=#d6b656;fillColor=#fff2cc;fontSize=11;align=left;spacingLeft=6;spacingRight=6;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="800" width="400" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- ═══════════════════════════════════════════════
       PAGE 5 — GANTT CHART
       ═══════════════════════════════════════════════ -->
  <diagram id="gantt" name="5 - Gantt Chart">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Gantt Chart — UniReg Project Schedule (10-Day Sprint)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="10" width="1200" height="40" as="geometry" />
        </mxCell>

        <!-- Header row -->
        <mxCell id="h0" value="Task" style="text;html=1;strokeColor=#666;fillColor=#f5f5f5;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="60" width="260" height="30" as="geometry" />
        </mxCell>
        <mxCell id="h_owner" value="Owner" style="text;html=1;strokeColor=#666;fillColor=#f5f5f5;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="280" y="60" width="70" height="30" as="geometry" />
        </mxCell>

