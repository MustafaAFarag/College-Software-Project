        <mxCell id="f2e6" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="d_wl" target="s_get_wl" parent="laneSystem"><mxGeometry relative="1" as="geometry" /></mxCell>
