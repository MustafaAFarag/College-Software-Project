        <mxCell id="f1e8" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="d2" target="err2" parent="laneSystem"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f1e9" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="d2" target="d3" parent="laneSystem"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="f1e10" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="d3" target="err3" parent="laneSystem"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f1e11" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="d3" target="d4" parent="laneSystem"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="f1e12" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="d4" target="err4" parent="laneSystem"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f1e13" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="d4" target="d5" parent="laneSystem"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="f1e14" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="d5" target="err5" parent="laneSystem"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f1e15" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="d5" target="d6" parent="laneSystem"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="f1e16" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="d6" target="s_wl" parent="laneSystem"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f1e17" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="d6" target="s_enr" parent="laneSystem"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- s_enr → a_result (crosses lanes) -->
